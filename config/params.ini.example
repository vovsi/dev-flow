; Скопируйте этот файл в params.ini и укажите свои значения.
; params.ini не попадает в git (см. .gitignore) — в нём хранятся токены и локальные адреса.

; Нейронка для генерации имени ветки, commit message, описания PR и перевода цитаты.
; provider выбирает, куда идут запросы: "anthropic" (Claude по API) или "lmstudio" (LM Studio
; и совместимые серверы). Настройки обоих провайдеров лежат рядом — переключение это одна
; строка provider, ничего удалять не нужно. Не задано — "lmstudio".
;
; provider = "anthropic":
;   anthropic_api_key — ключ с https://platform.claude.com (обязателен, иначе LLM-фичи отключены)
;   anthropic_model — необязательно, по умолчанию claude-haiku-4-5 (самая дешёвая и быстрая)
; provider = "lmstudio":
;   lmstudio_host — адрес нейронки. Проект запущен в Docker, поэтому "localhost" изнутри контейнера
;     указывает на сам контейнер, а не на хост-машину — используйте host.docker.internal
;     (или IP хост-машины в локальной сети), если нейронка крутится на хосте.
;   lmstudio_model — название модели, загруженной в LM Studio
[llm]
provider = "anthropic"
anthropic_api_key = "sk-ant-..."
anthropic_model = "claude-haiku-4-5"
lmstudio_host = "http://host.docker.internal:1234"
lmstudio_model = "deepseek-coder-v2-lite-instruct"

[github]
; Ники ревьюверов для команды `gh pr create --reviewer`, через запятую при нескольких.
reviewers = "your-github-nickname"

; Пункты «Rebase …» в дропдауне git-команд у названия ветки: «Подпись:базовая-ветка»,
; через запятую при нескольких. Подпись — как показать в меню, базовая ветка подставляется
; в команду `git rebase origin/<база>`. Необязательно — не задано, пунктов rebase нет.
[git]
rebase_targets = "API3:main, Adminka:dev"

; Порядок работы с пунктами чек-листа.
; strict_order = 1 (по умолчанию) — строгая очерёдность: активен только первый невыполненный
;   пункт, остальные заблокированы, выполненный пункт улетает из списка, а перескочить к
;   нужному шагу можно кнопкой «Перейти сюда».
; strict_order = 0 — свободный список: видны все пункты задачи, включая уже выполненные, и
;   нажать можно любой из них в любой момент (кнопка «Перейти сюда» тогда не нужна и не
;   показывается).
[checklist]
strict_order = 1

; Специфичные для команды куски текстов, которые не должны быть зашиты в код.
; review_skip_migration_repos — репозитории, где миграции не выполняются: перечисляются в
;   промпте Claude-ревью как исключение («не проверяй миграции»). Не задано — блока в промпте нет.
[templates]
review_skip_migration_repos = "api_v3, adminka"

; Ссылки на внутреннюю документацию команды (Confluence и т.п.) — подставляются в промпт
; Claude-ревью рядом с соответствующими пунктами чек-листа ревьювера. Каждый ключ
; необязателен: не задан — ссылка в промпт просто не подставляется.
; php_code_style — стандарт стиля PHP-кода команды
; testing_standards — стандарты написания тестов
; api_data_format — стандарт формата данных API
[docs]
php_code_style = "https://your-domain.atlassian.net/wiki/spaces/DevTeam/pages/000000001"
testing_standards = "https://your-domain.atlassian.net/wiki/spaces/DevTeam/pages/000000002"
api_data_format = "https://your-domain.atlassian.net/wiki/spaces/DevTeam/pages/000000003"

[atlassian]
; Данные для подтягивания заголовка/описания задачи из Jira при открытии (см. README).
; base_url — адрес вашего Jira (Cloud или Server), например https://your-domain.atlassian.net
; email — почта аккаунта Atlassian, на которую выпущен api_token
; api_token — API-токен, создаётся на https://id.atlassian.com/manage-profile/security/api-tokens
base_url = "https://your-domain.atlassian.net"
email = "you@example.com"
api_token = "your-api-token"
; ID кастомного поля Story Points (нужно для пункта «Указать Story Points»).
; Необязательно — по умолчанию customfield_10016 (стандартное поле в большинстве Jira Cloud).
; Найти свой ID можно через GET /rest/api/2/field.
story_points_field = "customfield_10016"
; Название статуса Jira, задачи в котором считает показатель дашборда «Blocked» (задачи на
; вас, застрявшие в блокировке дольше [dashboard].stale_blocked_hours рабочих часов).
; Необязательно — по умолчанию "Blocked".
blocked_status = "Blocked"
; Название статуса Jira, в который переводится задача по пункту «Перевести задачу в
; Pull Request» (должно точно совпадать с названием перехода в workflow вашей Jira).
; Необязательно — по умолчанию "Pull request".
pull_request_status = "Pull request"
; Название статуса Jira, в который переводится задача по пункту «Перевести в статус Doing»
; (должно точно совпадать с названием перехода в workflow вашей Jira). Можно перечислить
; через запятую несколько названий в порядке приоритета — например, если в разных проектах
; Jira той же команды один и тот же статус называется по-разному ("Doing, В работе"):
; используется первый переход, который реально нашёлся в workflow конкретной задачи.
; Необязательно — по умолчанию "Doing".
doing_status = "Doing"

; Рабочий день для ползунка быстрого трека времени (кружок рядом с индикатором
; затреканного за сегодня времени): границы ползунка и норма часов в день, по которой
; затреканное время подсвечивается оранжевым (меньше нормы) или зелёным (норма и больше).
; Необязательно — по умолчанию 09:00, 18:00 и 8 часов.
; lunch_start/lunch_end — обеденный перерыв: подсвечивается на ползунке оранжевым и не идёт
; в трекинг (по умолчанию 12:00–13:00). Обед вне границ рабочего дня просто отключается.
; non_working_days — дни недели, которые не идут в счёт часов «зависания» задачи в
; показателях дашборда «Зависшие PR» и «Blocked» (перевели PR в пятницу 17:00 — зависшим он
; станет в понедельник 17:00, а не в субботу). Формат: «sat, sun» (можно полными названиями) или
; номера ISO-8601 «6, 7», где 1 = Пн … 7 = Вс. Ключ не задан — суббота и воскресенье;
; задан пустым — не пропускается ни один день. Перечислены все семь — список игнорируется.
[worktime]
start = "09:00"
end = "18:00"
daily_hours = 8
lunch_start = "12:00"
lunch_end = "13:00"
non_working_days = "sat, sun"

; Показатели «Зависшие PR» и «Blocked» на дашборде (экран ввода ссылки).
; stale_pull_request_hours — сколько часов задача может висеть в статусе
; [atlassian].pull_request_status, прежде чем попасть в счётчик.
; stale_blocked_hours — то же для статуса [atlassian].blocked_status.
; У каждого показателя порог свой: заблокированная задача и висящий PR — разные ожидания.
; В обоих считаются только часы рабочих дней: дни из [worktime].non_working_days
; пропускаются целиком. Необязательно — по умолчанию 24 (см. Config::STALE_PULL_REQUEST_HOURS_DEFAULT
; и Config::STALE_BLOCKED_HOURS_DEFAULT).
[dashboard]
stale_pull_request_hours = 24
stale_blocked_hours = 24

; Заработок за день в модалке поздравления (появляется, когда трек времени за день достигает
; [worktime].daily_hours) — оклад в USD/месяц делится на условное число рабочих часов в месяце
; (working_days_per_month × daily_hours), затем пересчитывается в валюту из [currency].
; Необязательно — по умолчанию 1500 и 21 (см. Config::SALARY_DEFAULTS).
[salary]
monthly_usd = 1500
working_days_per_month = 21

; Валюта, в которой показывается заработок в модалке поздравления.
; code — код валюты для курса USD → X (должен быть в ответе сервиса курсов, [services].exchange_rate_url)
; label — подпись рядом с суммой в интерфейсе.
; Необязательно — по умолчанию UAH и «грн» (см. Config::CURRENCY_DEFAULTS).
[currency]
code = "UAH"
label = "грн"

; Адреса внешних сервисов без ключей/токенов (те, что с токенами, — в своих секциях выше:
; [atlassian] и [llm]). Необязательно — по умолчанию значения ниже (см. Config::SERVICE_URL_DEFAULTS).
; exchange_rate_url — курс валют для расчёта заработка, база USD, ответ вида {"rates": {"UAH": 41.2}}
; quotes_url — случайная цитата для модалки поздравления, ответ вида [{"q": "...", "a": "author"}]
[services]
exchange_rate_url = "https://open.er-api.com/v6/latest/USD"
quotes_url = "https://zenquotes.io/api/random"

; Уведомления Claude Code (десктопное приложение) в Telegram — тумблер в разделе «Claude»
; настроек DevFlow (иконка шестерёнки). Включение записывает в settings.json Claude Code блок
; hooks на события Notification/Stop (curl в Telegram), выключение — удаляет ключ hooks целиком
; (что бы в нём ни лежало). settings.json смонтирован в контейнер как /claude/settings.json
; (см. docker-compose.yml, ${HOME}/.claude/settings.json с хоста).
; telegram_bot_token/telegram_chat_id обязательны — не заданы, раздел «Claude» просто не
; показывается в настройках. Токен бота — от @BotFather, chat_id — свой numeric id
; (например через @userinfobot).
; settings_path — необязательно, путь глазами приложения; по умолчанию /claude/settings.json.
; notification_text/stop_text — необязательно, тексты сообщений; дефолты — как были раньше
; в settings.json этого пользователя.
[claude]
telegram_bot_token = "123456:AA...your-bot-token"
telegram_chat_id = "000000000"
notification_text = "🔔 Claude Code просит внимания!"
stop_text = "✅ Claude Code завершил задачу!"
